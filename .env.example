# =====================================================================
# ملتقى المسك القرآني — متغيرات البيئة
# محليًا: انسخ هذا الملف إلى  server/.env  (أو .env في جذر المشروع) وعبّئ القيم
# على Render: أدخل نفس المتغيرات في Environment (لا ترفع ملف .env إلى GitHub)
# =====================================================================

# رابط قاعدة بيانات Supabase  (Project Settings → Database → Connection string → "Session pooler")
# مهم: استبدل [YOUR-PASSWORD] بكلمة مرور قاعدة البيانات. إن احتوت رموزًا خاصة (@ # / :) رمّزها (URL-encode).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# مفتاح توقيع الجلسات — 32 حرفًا فأكثر وعشوائي. لتوليده:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# مفتاح تشفير كلمات مرور المشرفين التي يعرضها المسؤول (غيّره = تضيع كلمات المرور المعروضة ويمكن إعادة توليدها)
CREDENTIALS_KEY=

# حساب المسؤول الإداري (يُنشأ تلقائيًا عند أول تشغيل إن لم يكن موجودًا)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=المسؤول الإداري
# إن نسيت كلمة مرور المسؤول: ضع كلمة جديدة في ADMIN_PASSWORD و ADMIN_FORCE_RESET=true ثم أعد التشغيل، ثم أزل السطر.
# ADMIN_FORCE_RESET=true

# المنطقة الزمنية المستخدمة لساعات الدوام وحدود الأيام
APP_TIMEZONE=Asia/Hebron

# المنفذ (Render يضبطه تلقائيًا)
PORT=4000

# اختياري: فقط إن شغّلت الواجهة من نطاق مختلف عن الـ API
# CLIENT_ORIGIN=https://your-frontend.example.com

NODE_ENV=development
